{
  "name": "@nomad/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-knowledge.mjs",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/server.js --production",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^3.24.1",
    "@nomad/shared": "1.0.0",
    "ws": "^8.22.0",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^5.0.0",
    "@types/ws": "^8.18.2",
    "@types/cookie-parser": "^1.4.10"
  }
}
